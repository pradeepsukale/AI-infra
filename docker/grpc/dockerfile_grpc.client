# ---------- build stage ----------
FROM golang:1.24-alpine AS build

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Build the gRPC client binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -o grpc-client ./grpcdemo/grpcdemo/greeterpb/client

# ---------- runtime stage ----------
FROM gcr.io/distroless/base-debian12

WORKDIR /app

COPY --from=build /app/grpc-client /app/grpc-client

USER nonroot:nonroot

ENTRYPOINT ["/app/grpc-client"]

